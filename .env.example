# SMTP server settings (use credentials from your mail provider)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients are supported.
SMTP_TO=
# Set exactly one transport mode: implicit TLS (usually 465), or STARTTLS (usually 587).
SMTP_USE_SSL=false
SMTP_USE_TLS=true
